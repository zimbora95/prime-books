# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Reading-assistant secrets. .env.local holds the Hermes API_SERVER_KEY, which
# grants the agent's full toolset (including terminal) - it must NEVER be
# committed or served. Covered by *.local above; named here so nobody "tidies"
# that pattern away.
.env.local
.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Serving copies of the real books (masters live on H: drive Output/ folders).
# Regenerate with: python tools/sync_books.py
# The old flat root copies are superseded by public/books/:
public/*.pdf
copy-books.sh

# NOTE: public/books/ is deliberately NOT ignored. The flipbook Preview fetches
# these over HTTP, so they must be committed and deployed with the site -
# gitignoring them is what made Preview 404 with MissingPDFException on Vercel.
# tools/sync_books.py keeps them web-sized (~130 MB total, largest file 25 MB,
# well inside GitHub's 100 MB per-file limit; Vercel's 100 MB cap applies to
# CLI uploads, not Git-integration deployments).

# Workspace data — not for deployment
public/subjects/
public/covers/

# Python bytecode. tools/__pycache__/webopt_pdf.cpython-311.pyc was committed by
# accident and showed up as a modified file on every sync run.
__pycache__/
*.pyc

# Verification-harness scratch output
uiauth.log
*.tmp.js

# Manifest variant carrying absolute MEGA paths: local authoring only, must
# never deploy (it would publish the folder layout of the masters).
public/books-manifest.local.json
