rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read on all book content
    match /books/{slug} {
      allow read: if true;
      allow write: if request.auth != null
                && request.auth.token.email in ['alexandreruffer@primeschool.pt'];
    }

    match /books/{slug}/units/{unitId} {
      allow read: if true;
      allow write: if request.auth != null
                && request.auth.token.email in ['alexandreruffer@primeschool.pt'];
    }

    // Catch-all: public read, owner-only write
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null
                && request.auth.token.email in ['alexandreruffer@primeschool.pt'];
    }
  }
}